--- a/src/platform.h
+++ b/src/platform.h
@@ -31,11 +31,33 @@
 
 #if defined(__ANDROID__)
 #   include <android/log.h>
-#   define LOG_TAG_EMU "[PsyX] "
-#   define eprintf(fmt, ...)       __android_log_print(ANDROID_LOG_DEBUG, LOG_TAG_EMU, fmt, ##__VA_ARGS__)
-#   define eprintinfof(fmt, ...)   __android_log_print(ANDROID_LOG_DEBUG, LOG_TAG_EMU " [INFO]", fmt, ##__VA_ARGS__)
-#   define eprintwarnf(fmt, ...)   __android_log_print(ANDROID_LOG_DEBUG, LOG_TAG_EMU " [WARN]", fmt, ##__VA_ARGS__)
-#   define eprinterr(fmt, ...)     eprintf("[%s] - " fmt, FUNCNAME, ##__VA_ARGS__);
+#   include <stdarg.h>
+#   include <stdio.h>
+#   define LOG_TAG_EMU "PsyX"
+
+// Format into a buffer first, then hand logcat a literal "%s". Passing a
+// runtime format string straight to __android_log_print() trips the NDK's
+// -Werror=format-security, and callers do log variables.
+static inline void PsyX_AndroidLog(int prio, const char* fmt, ...)
+{
+    char buffer[1024];
+    va_list args;
+
+    va_start(args, fmt);
+    vsnprintf(buffer, sizeof(buffer), fmt, args);
+    va_end(args);
+
+    __android_log_print(prio, LOG_TAG_EMU, "%s", buffer);
+}
+
+// The rest of the code base calls eprintinfo/eprintwarn; this branch used to
+// define only the *f spellings, so nothing under __ANDROID__ ever compiled.
+#   define eprintf(fmt, ...)       PsyX_AndroidLog(ANDROID_LOG_DEBUG, fmt, ##__VA_ARGS__)
+#   define eprintinfo(fmt, ...)    PsyX_AndroidLog(ANDROID_LOG_INFO,  fmt, ##__VA_ARGS__)
+#   define eprintinfof(fmt, ...)   eprintinfo(__VA_ARGS__)
+#   define eprintwarn(fmt, ...)    PsyX_AndroidLog(ANDROID_LOG_WARN,  fmt, ##__VA_ARGS__)
+#   define eprintwarnf(fmt, ...)   eprintwarn(__VA_ARGS__)
+#   define eprinterr(fmt, ...)     PsyX_AndroidLog(ANDROID_LOG_ERROR, "[%s] - " fmt, FUNCNAME, ##__VA_ARGS__);
 #else
 #   define eprintf(fmt, ...)       PsyX_Log("[Psy-X] " fmt, ##__VA_ARGS__)
 #   define eprintinfo(fmt, ...)    PsyX_Log_Info("[Psy-X] " fmt, ##__VA_ARGS__)
