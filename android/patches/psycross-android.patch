-#	define VRAM_FORMAT            GL_LUMINANCE_ALPHA
-#	define VRAM_INTERNAL_FORMAT   GL_LUMINANCE_ALPHA
+/* GL_LUMINANCE_ALPHA does not exist in OpenGL ES, so the VRAM texture could
+ * never be created there: glTexImage2D failed with GL_INVALID_ENUM, the
+ * framebuffer that renders back into VRAM stayed incomplete, and every frame
+ * that blitted the screen into it raised GL_INVALID_FRAMEBUFFER_OPERATION
+ * (0x0506) and showed nothing. RG8 carries the same two bytes per PSX pixel
+ * and *is* colour-renderable in ES 3.0; the shader's VRAM() picks .rg for it,
+ * which reads the identical (high, low) byte pair LUMINANCE_ALPHA's .ra did. */
+#	define VRAM_FORMAT            GL_RG
+#	define VRAM_INTERNAL_FORMAT   GL_RG8
 #endif
 
 #define VRAM_WIDTH		(1024)
