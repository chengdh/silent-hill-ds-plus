diff --git a/pc_port/include/gl_compat.h b/pc_port/include/gl_compat.h
new file mode 100644
index 000000000..8f6a78e3d
--- /dev/null
+++ b/pc_port/include/gl_compat.h
@@ -0,0 +1,36 @@
+#ifndef GL_COMPAT_H
+#define GL_COMPAT_H
+
+/* Single place where the port reaches the GL entry points.
+ *
+ * Desktop builds go through PsyX's bundled glad loader: gladLoadGL() runs once
+ * after the context is made current and fills glad's function-pointer table.
+ *
+ * The GLES build does not use that loader (PsyX_render.h links the ES entry
+ * points directly, and its glad.h copy is generated for gles2=2.0 only), so
+ * every glad_gl* pointer stays NULL there. Including glad.h on this path does
+ * not fail to build -- it just makes each GL call jump to address 0 at runtime,
+ * which is exactly how HiresOverride_ClampBudgetToVram crashed on first launch
+ * (SIGSEGV at pc=0 from glGetIntegerv). Use the real ES headers instead.
+ */
+#if defined(__ANDROID__)
+#   include <GLES3/gl3.h>
+
+/* glGetTexLevelParameteriv, and these pnames with it, arrived in ES 3.1; the
+ * 3.0 headers do not define them. hires_override.c already gates the query on
+ * g_grCaps.texLevelParam (0 on ES 3.0), so the branch never executes here --
+ * it just has to compile. Values are the real GL ones, not placeholders. */
+#   ifndef GL_TEXTURE_WIDTH
+#      define GL_TEXTURE_WIDTH 0x1000
+#   endif
+#   ifndef GL_TEXTURE_HEIGHT
+#      define GL_TEXTURE_HEIGHT 0x1001
+#   endif
+#   ifndef GL_TEXTURE_INTERNAL_FORMAT
+#      define GL_TEXTURE_INTERNAL_FORMAT 0x1003
+#   endif
+#else
+#   include <PsyX/common/glad.h>
+#endif
+
+#endif /* GL_COMPAT_H */
