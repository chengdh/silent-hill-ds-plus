# Pinned sources and toolchain for the Android build.
# Sourced by build.sh; keep this file POSIX-sh compatible (VAR=value only).

# Upstream: identical pins to patches/manifest.json for the RG DS Plus build.
UPSTREAM_REPO=https://github.com/SlickAmogus/silent-hill-decomp.git
UPSTREAM_COMMIT=60ed02045da3dbd3d5633e9528f33707b0f03c95
PSYCROSS_COMMIT=20a2fb4798be6c57ebe799dc03e07338b5551563

# Third-party dependencies built from source with the NDK.
SDL2_REPO=https://github.com/libsdl-org/SDL.git
SDL2_REF=release-2.32.10
OPENAL_REPO=https://github.com/kcat/openal-soft.git
OPENAL_REF=1.25.2
JPEG_REPO=https://github.com/libjpeg-turbo/libjpeg-turbo.git
JPEG_REF=3.2.1

# Android target. arm64-v8a only: SH_STATIC_MAPS reserves roughly 200 MB of
# .bss, which a 32-bit address space cannot comfortably hold.
ANDROID_NDK_VERSION=27.2.12479018
ANDROID_PLATFORM=android-24
ANDROID_ABIS=arm64-v8a
ANDROID_COMPILE_SDK=34
ANDROID_MIN_SDK=24
ANDROID_STL=c++_shared
